# Neon PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/oneatlas?schema=public"

# Optional: Next.js Public App URL (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
