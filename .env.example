# Neon PostgreSQL Database Connection (Pooled connection for serverless runtime on Vercel)
# Format: postgresql://[user]:[password]@[neon_hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Direct Connection (Non-pooled connection for migrations and prisma db push)
DIRECT_URL="postgresql://postgres:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Next.js Public App URL (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
