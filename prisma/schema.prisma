datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lab {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  color       String?  // Hex brand color e.g. #10A37F
  models      Model[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Provider {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  apiDocUrl   String?
  models      ModelProvider[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
}

model Model {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  description     String
  labId           String
  lab             Lab               @relation(fields: [labId], references: [id], onDelete: Cascade)
  modelType       String            // chat, embedding, image, audio, code, multimodal
  contextWindow   Int               // In tokens (e.g. 128000, 1000000)
  maxOutputTokens Int?              // In tokens (e.g. 4096, 16384)
  inputPricePerM  Float             // Price in USD per 1M tokens
  outputPricePerM Float             // Price in USD per 1M tokens
  releaseDate     DateTime
  license         String            // open, closed
  parameters      String?           // e.g. "70B", "405B", "MoE 8x7B"
  isFeatured      Boolean           @default(false)
  providers       ModelProvider[]
  capabilities    ModelCapability[]
  modalities      Modality[]
  benchmarkScores BenchmarkScore[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slug])
  @@index([labId])
  @@index([releaseDate])
  @@index([inputPricePerM, outputPricePerM])
  @@index([contextWindow])
  @@index([modelType])
  @@index([isFeatured])
}

model ModelProvider {
  id              String   @id @default(cuid())
  modelId         String
  providerId      String
  model           Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputPricePerM  Float    // Provider-specific input price ($/1M)
  outputPricePerM Float    // Provider-specific output price ($/1M)
  latencyMs       Float    // Typical time to first token in ms
  throughput      Float    // Output tokens per second
  uptimePercent   Float    // e.g. 99.95
  isDefault       Boolean  @default(false)
  contextWindow   Int?     // Specific context limit if different from model spec
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([modelId, providerId])
  @@index([modelId])
  @@index([providerId])
}

model Benchmark {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String           // e.g. MMLU, GPQA Diamond, SWE-bench
  category       String           // Reasoning, Coding, Math, General Knowledge, Agentic, Human Preference
  description    String?
  metricUnit     String           @default("%") // "%", "Elo", "pts"
  maxScore       Float?           @default(100.0)
  higherIsBetter Boolean          @default(true)
  scores         BenchmarkScore[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([category])
}

model BenchmarkScore {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  score       Float
  sourceUrl   String?
  verified    Boolean   @default(true)
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([modelId, benchmarkId])
  @@index([modelId])
  @@index([benchmarkId, score])
}

model Capability {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String            // Vision, Tool Calling, Reasoning, JSON Mode, Streaming, etc.
  description String?
  icon        String?           // Lucide icon name or svg identifier
  models      ModelCapability[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
}

model ModelCapability {
  id           String     @id @default(cuid())
  modelId      String
  capabilityId String
  model        Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([modelId, capabilityId])
  @@index([modelId])
  @@index([capabilityId])
}

model Modality {
  id           String   @id @default(cuid())
  modelId      String
  modalityType String   // text, image, audio, video
  direction    String   // input, output
  model        Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([modelId, modalityType, direction])
  @@index([modelId])
  @@index([modalityType, direction])
}
